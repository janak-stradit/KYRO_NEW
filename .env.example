# ============================================================
# KYRO AML Risk Assessment — Environment Configuration
# Copy to .env and fill in production values before deploying.
# NEVER commit .env with real credentials to source control.
# ============================================================

# ── Application ───────────────────────────────────────────────
APP_NAME=KYRO Risk Assessment
DEBUG=False
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# ── API Server ────────────────────────────────────────────────
API_PORT=8000
API_HOST_PORT=8010                # External port if 8000 is taken on host

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://your_db_username:your_secure_db_password@localhost:5432/kyro_aml

# ── Redis (Session & Caching) ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_HOST_PORT=6379

# ── Authentication & Security ─────────────────────────────────
SECRET_KEY=your_secret_key_generate_with_openssl_rand_hex_32  # CHANGE: Use `openssl rand -hex 32`
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── HTTP hardening ────────────────────────────────────────────
# Comma-separated cross-origin allow-list. The bundled frontend is same-origin
# (nginx proxies /api/) and needs no entry. "*" is ignored.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_LOGIN=10/minute
# Shared counters across workers/replicas; leave empty for in-memory.
RATE_LIMIT_STORAGE_URI=redis://redis:6379/1

# ── ML Engine ─────────────────────────────────────────────────
MODEL_REGISTRY_PATH=./models
RETRAIN_THRESHOLD=1000
PERFORMANCE_THRESHOLD=0.85
TRAINING_DATA_DAYS=365
SHAP_EXPLANATION_TOP_K=5

# ── ElevenLabs TTS (Optional) ─────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_MODEL_ID=eleven_turbo_v2
TTS_PROVIDER=elevenlabs

# ── Compliance AI (Phase 11, docs/plans/COMPLIANCE_AI_PLAN.md) ──
# OpenAI-compatible LLM endpoint. Put the real key in local.env / .env only,
# never in this file; production uses AWS Secrets Manager.
KYRO_AI_ENABLED=false
KYRO_LLM_MOCK=true
KYRO_LLM_BASE_URL=https://your-llm-gateway.example/v1
KYRO_LLM_API_KEY=your_llm_api_key_here
KYRO_LLM_MODEL=claude-haiku-4-5-20251001
KYRO_LLM_TIMEOUT_SECONDS=30

# Refuse direct rule-threshold edits so every change goes through two-person approval
RULE_CHANGES_REQUIRE_APPROVAL=false

# Let anyone create their own analyst account without signing in (demo environments only).
# When false, users are created by an administrator on the Administration page.
ALLOW_SELF_REGISTRATION=false

# Score every new transaction with the ML models as it is recorded (after the rules engine)
ML_AUTO_SCORE=true

# Let the Data Feeds page start and stop a live feed of synthetic transactions
# (demo and development only; never where real customer data is held).
SYNTHETIC_FEED_ENABLED=false

# Days a case may stay open before it is shown as overdue, by risk band (set to your policy)
CASE_TARGET_DAYS_HIGH=5
CASE_TARGET_DAYS_MEDIUM=10
CASE_TARGET_DAYS_LOW=20

# Where uploaded KYC documents are stored (keep outside the repository; encrypted storage in production)
DOCUMENT_STORAGE_DIR=var/documents
