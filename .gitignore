# ── Python ────────────────────────────────────────────────────
venv/
.venv-api/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/

# ── ML model artifacts (regenerated via training) ──────────────
models/*.pkl
models/registry.json

# ── Database files (contain sensitive data) ────────────────────
*.db
*.sqlite
*.sqlite3
kyro_aml.db

# ── Logs (runtime generated) ────────────────────────────────────
logs/
*.log
nohup.out
pipeline.log
pipeline_logs.txt
latest_output.txt
*.out

# ── App output / secrets ────────────────────────────────────────
output/
*.xlsx
.env
pyrightconfig.json

# ── IDE ───────────────────────────────────────────────────────
.idea/

# ── Let's Encrypt certs (host-only, never committed) ────────────
certbot/

# ── Test and utility files (not needed on server) ─────────────
tests/
**/tests/
test_*.py
*_test.py
check_*.py
audit_*.py
fix_*.py
populate_*.py
train_*.py
test_*.sh
start_*.sh
*.test.js
*.spec.js
*.test.ts
*.spec.ts

# ── Documentation (not needed on server) ───────────────────────
CHANGES_SUMMARY.md
E2E_TEST_REPORT.md
GITHUB_STATUS.md
*_REPORT.md
*_SUMMARY.mdoard.py

# ── Old/Obsolete Frontend Files ───────────────────────────────
frontend/index.html
frontend/aml-*.html
frontend/js/
frontend/styles/
frontend/assets/
